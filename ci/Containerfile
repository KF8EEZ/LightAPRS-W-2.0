# Headless arduino-cli image for compile-checking the LightAPRS-W 2.0 sketches
# (ATSAMD21G18 / Arduino M0). This is a CI / build-verification companion to the
# GUI Arduino IDE container at https://github.com/anielsen001/arduino-container --
# use that one for editing and flashing over USB.
#
# Build (from the repo root):
#   podman build -t arduino-cli-samd ci/
# Compile check:
#   ci/compile.sh
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git python3 \
    && rm -rf /var/lib/apt/lists/*

# arduino-cli. The install script is fetched from master but the CLI version it
# installs is pinned by the argument to `sh -s`.
ARG ARDUINO_CLI_VERSION=1.1.1
RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh \
        | BINDIR=/usr/local/bin sh -s ${ARDUINO_CLI_VERSION}

ENV ARDUINO_DIRECTORIES_DATA=/opt/arduino/data \
    ARDUINO_DIRECTORIES_DOWNLOADS=/opt/arduino/downloads \
    ARDUINO_DIRECTORIES_USER=/opt/arduino/user

# Arduino SAMD core (Arduino M0 = FQBN arduino:samd:mzero_bl). Installing the core
# also pulls the arm-none-eabi-gcc 7-2017q4 toolchain and bossac as tool deps.
ARG SAMD_VERSION=1.8.14
RUN arduino-cli core update-index \
    && arduino-cli core install arduino:samd@${SAMD_VERSION} \
    && arduino-cli version

WORKDIR /work
ENTRYPOINT ["arduino-cli"]
